<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>AETHER SHOES</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.min.js"></script>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:#0b0b0d;
color:white;
overflow-x:hidden;
}

canvas{
position:fixed;
top:0;
left:0;
z-index:-1;
}

/* NAVBAR */

nav{
width:100%;
padding:22px 8%;
display:flex;
justify-content:space-between;
align-items:center;
position:fixed;
top:0;
z-index:1000;
backdrop-filter:blur(12px);
background:rgba(0,0,0,0.15);
border-bottom:1px solid rgba(255,255,255,0.05);
}

.logo{
font-size:28px;
font-weight:700;
letter-spacing:4px;
}

nav ul{
display:flex;
gap:35px;
list-style:none;
}

nav ul li a{
text-decoration:none;
color:#d9d9d9;
font-size:15px;
transition:0.3s;
}

nav ul li a:hover{
color:white;
}

/* HERO */

.hero{
min-height:100vh;
display:flex;
justify-content:space-between;
align-items:center;
padding:120px 8%;
gap:50px;
}

.hero-text{
flex:1;
}

.tag{
display:inline-block;
padding:8px 18px;
background:rgba(255,255,255,0.08);
border:1px solid rgba(255,255,255,0.08);
border-radius:50px;
font-size:13px;
margin-bottom:25px;
color:#d1d1d1;
}

.hero-text h1{
font-size:82px;
line-height:1;
margin-bottom:25px;
font-weight:700;
}

.hero-text p{
color:#a5a5a5;
font-size:16px;
line-height:1.9;
max-width:520px;
margin-bottom:35px;
}

.hero-buttons{
display:flex;
gap:18px;
flex-wrap:wrap;
}

.btn{
padding:15px 34px;
border:none;
border-radius:50px;
cursor:pointer;
font-size:15px;
font-weight:600;
transition:0.3s;
}

.btn-primary{
background:white;
color:black;
}

.btn-primary:hover{
transform:translateY(-3px);
}

.btn-secondary{
background:transparent;
border:1px solid rgba(255,255,255,0.15);
color:white;
}

.btn-secondary:hover{
background:rgba(255,255,255,0.08);
}

.hero-image{
flex:1;
display:flex;
justify-content:center;
position:relative;
}

.hero-image img{
width:100%;
max-width:650px;
filter:drop-shadow(0 30px 50px rgba(0,0,0,0.5));
animation:float 5s ease-in-out infinite;
}

.glow{
position:absolute;
width:450px;
height:450px;
background:radial-gradient(circle,rgba(255,255,255,0.14),transparent 70%);
border-radius:50%;
top:50%;
left:50%;
transform:translate(-50%,-50%);
z-index:-1;
}

@keyframes float{
0%{transform:translateY(0px);}
50%{transform:translateY(-20px);}
100%{transform:translateY(0px);}
}

/* COLLECTION */

.section{
padding:110px 8%;
}

.section-title{
text-align:center;
margin-bottom:70px;
}

.section-title h2{
font-size:52px;
margin-bottom:12px;
}

.section-title p{
color:#9f9f9f;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
gap:30px;
}

.card{
background:rgba(255,255,255,0.04);
border:1px solid rgba(255,255,255,0.05);
border-radius:28px;
padding:30px;
transition:0.4s;
}

.card:hover{
transform:translateY(-10px);
background:rgba(255,255,255,0.06);
}

.card img{
width:100%;
height:220px;
object-fit:contain;
margin-bottom:20px;
}

.card h3{
font-size:24px;
margin-bottom:8px;
}

.card p{
color:#9f9f9f;
font-size:14px;
line-height:1.7;
margin-bottom:18px;
}

.price{
font-size:22px;
font-weight:600;
margin-bottom:20px;
}

/* FEATURE */

.feature{
display:flex;
align-items:center;
justify-content:space-between;
gap:70px;
flex-wrap:wrap;
}

.feature-image{
flex:1;
}

.feature-image img{
width:100%;
border-radius:28px;
}

.feature-text{
flex:1;
}

.feature-text h2{
font-size:60px;
line-height:1.1;
margin-bottom:25px;
}

.feature-text p{
color:#a1a1a1;
line-height:1.9;
margin-bottom:30px;
}

/* STATS */

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:25px;
margin-top:70px;
}

.stat{
padding:35px;
border-radius:24px;
background:rgba(255,255,255,0.04);
text-align:center;
}

.stat h3{
font-size:42px;
margin-bottom:10px;
}

.stat p{
color:#9d9d9d;
}

/* FOOTER */

footer{
padding:70px 8%;
border-top:1px solid rgba(255,255,255,0.05);
text-align:center;
}

footer h2{
font-size:32px;
margin-bottom:15px;
}

footer p{
color:#9d9d9d;
}

/* MOBILE */

@media(max-width:950px){

.hero{
flex-direction:column;
text-align:center;
}

.hero-text p{
margin:auto auto 35px;
}

.hero-buttons{
justify-content:center;
}

.hero-text h1{
font-size:58px;
}

.feature{
flex-direction:column;
}

.feature-text{
text-align:center;
}

.feature-text h2{
font-size:45px;
}

nav ul{
display:none;
}

}

</style>
</head>
